# ---------------------------------------------------------------------------
# Заняття 9. Скопіюйте цей файл у теку cluster/.
#
# Провайдер helm розмовляє з кластером через його сервер API. Усі значення
# беруться прямо з модуля eks у цій самій конфігурації.
#
# ЧОМУ ФАЙЛ КОПІЮЄТЬСЯ ПІЗНІШЕ, А НЕ ЛЕЖИТЬ У cluster/ З ПОЧАТКУ:
# провайдер налаштовується на кластер, який має вже існувати. Коли ви
# копіюєте файл, кластер піднятий і його адреса відома зі стану. Якби файл
# лежав тут від самого початку, перший plan на порожньому акаунті не зміг би
# налаштувати провайдер — кластера ще немає.
#
# НАСЛІДОК, ПРО ЯКИЙ ВАРТО ПАМ'ЯТАТИ: якщо колись знищите все й будуватимете
# з нуля, спершу підніміть кластер без цього файлу (або terraform apply
# -target=module.eks), і лише потім застосуйте решту.
# ---------------------------------------------------------------------------

# Токен засобами провайдера aws, а не командою aws eks get-token:
# на раннерах HCP Terraform немає AWS CLI, тож exec { command = "aws" } там падає.
data "aws_eks_cluster_auth" "this" {
  name = module.eks.cluster_name
}

provider "helm" {
  kubernetes = {
    host                   = module.eks.cluster_endpoint
    cluster_ca_certificate = base64decode(module.eks.cluster_certificate_authority_data)
    token                  = data.aws_eks_cluster_auth.this.token
  }
}
